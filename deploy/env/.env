# -----------------------------------------
# ОБЩИЙ ФАЙЛ КОНФИГУРАЦИИ МИКРОСЕРВИСНОЙ АРХИТЕКТУРЫ
# -----------------------------------------
# Этот файл содержит все переменные окружения для всех сервисов
# с префиксами для избежания конфликтов имен.
# -----------------------------------------

# -----------------------------------------
# CORE НАСТРОЙКИ (ОБЩИЕ КОМПОНЕНТЫ)
# -----------------------------------------

# Kafka настройки
CORE_KAFKA_EXTERNAL_PORT=9092
CORE_KAFKA_INTERNAL_PORT=29092
CORE_KAFKA_CONTROLLER_PORT=29093
CORE_KAFKA_UI_PORT=8090

# -----------------------------------------
# CORE — OPEN TELEMETRY (OTEL) & МОНИТОРИНГ
# -----------------------------------------

# OTEL Collector
CORE_OTEL_GRPC_PORT=4317
CORE_OTEL_HTTP_PORT=4318
CORE_OTEL_METRICS_PORT=8888
CORE_OTEL_BATCH_SIZE=1000
CORE_OTEL_BATCH_TIMEOUT=10s
CORE_OTEL_LOG_LEVEL=info

# Jaeger (трейсинг)
CORE_JAEGER_UI_PORT=16686
CORE_JAEGER_GRPC_PORT=4317

# Prometheus (метрики)
CORE_PROMETHEUS_PORT=9090
CORE_PROMETHEUS_EVALUATION_INTERVAL=15s

# Grafana (визуализация)
CORE_GRAFANA_PORT=3000
CORE_GRAFANA_ADMIN_USER=admin
CORE_GRAFANA_ADMIN_PASSWORD=admin

# Elasticsearch (логи)
CORE_ELASTICSEARCH_PORT=9200
CORE_ELASTICSEARCH_VERSION=9.0.0

# Kibana (визуализация логов)
CORE_KIBANA_PORT=5601

# -----------------------------------------
# IAM СЕРВИС
# -----------------------------------------

# gRPC настройки
IAM_GRPC_HOST=localhost
IAM_GRPC_PORT=50053

# Логгер
IAM_LOGGER_LEVEL=info
IAM_LOGGER_AS_JSON=true
IAM_LOG_OUTPUTS=stdout,otlp
IAM_OTEL_COLLECTOR_ENDPOINT=otel-collector:4317
IAM_SERVICE_NAME=iam-service
IAM_OTEL_TRACES_ENDPOINT=otel-collector:4317

# PostgreSQL
IAM_POSTGRES_HOST=localhost
IAM_POSTGRES_PORT=5444
IAM_EXTERNAL_POSTGRES_PORT=5444
IAM_POSTGRES_USER=iam_user
IAM_POSTGRES_PASSWORD=iam_password
IAM_POSTGRES_DB=iam
IAM_POSTGRES_SSL_MODE=disable
IAM_MIGRATION_DIRECTORY=./iam/migrations

# Redis
IAM_REDIS_HOST=localhost
IAM_REDIS_PORT=6333
IAM_EXTERNAL_REDIS_PORT=6333
IAM_REDIS_CONNECTION_TIMEOUT=10s
IAM_REDIS_MAX_IDLE=10
IAM_REDIS_IDLE_TIMEOUT=10s

# Сессии
IAM_SESSION_TTL=24h

# -----------------------------------------
# INVENTORY СЕРВИС
# -----------------------------------------

# gRPC настройки
INVENTORY_GRPC_HOST=localhost
INVENTORY_GRPC_PORT=50051

# gRPC клиенты
INVENTORY_IAM_GRPC_HOST=localhost
INVENTORY_IAM_GRPC_PORT=50053

# Логгер
INVENTORY_LOGGER_LEVEL=info
INVENTORY_LOGGER_AS_JSON=true
INVENTORY_LOG_OUTPUTS=stdout,otlp
INVENTORY_OTEL_COLLECTOR_ENDPOINT=otel-collector:4317
INVENTORY_SERVICE_NAME=inventory-service
INVENTORY_OTEL_TRACES_ENDPOINT=otel-collector:4317

# MongoDB
INVENTORY_MONGO_IMAGE_NAME=mongo:7.0.5
INVENTORY_EXTERNAL_MONGO_PORT=27018
INVENTORY_MONGO_HOST=localhost
INVENTORY_MONGO_PORT=27018
INVENTORY_MONGO_INITDB_DATABASE=inventory
INVENTORY_MONGO_AUTH_DB=admin
INVENTORY_MONGO_INITDB_ROOT_USERNAME=inventory_admin
INVENTORY_MONGO_INITDB_ROOT_PASSWORD=inventory_secret

# -----------------------------------------
# ORDER СЕРВИС
# -----------------------------------------

# gRPC клиенты
ORDER_IAM_GRPC_HOST=localhost
ORDER_IAM_GRPC_PORT=50053
ORDER_INVENTORY_GRPC_HOST=localhost
ORDER_INVENTORY_GRPC_PORT=50051
ORDER_PAYMENT_GRPC_HOST=localhost
ORDER_PAYMENT_GRPC_PORT=50052

# HTTP сервер
ORDER_HTTP_HOST=localhost
ORDER_HTTP_PORT=8080
